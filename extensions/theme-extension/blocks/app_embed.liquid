{% assign reorder_meta = shop.metafields.variant_image_automator.reorder_collections.value %}

{% assign is_reorder_mode = false %}
{% if reorder_meta and reorder_meta != "[]" and reorder_meta != blank %}
  {% for collection in product.collections %}
    {% assign gid = "gid://shopify/Collection/" | append: collection.id %}
    {% if reorder_meta contains gid %}
      {% assign is_reorder_mode = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if is_reorder_mode %}
  {% if product %}
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% assign featured_media_id = current_variant.featured_media.id | default: product.media.first.id %}

    <style>
      /* Initial Hide & Variant Switch Hide - Smooth Fade */
      html:not(.v-automator-ready) .product__media-list,
      html:not(.v-automator-ready) .thumbnail-list,
      html:not(.v-automator-ready) media-gallery,
      html.v-automator-updating .product__media-list,
      html.v-automator-updating .thumbnail-list,
      html.v-automator-updating media-gallery { 
        opacity: 0 !important;
        transition: opacity 0.15s ease-in-out;
      }

      /* Keep only the specific featured media item visible */
      html:not(.v-automator-ready) .product__media-item[data-media-id*="{{ featured_media_id }}"],
      html:not(.v-automator-ready) .product__media-list li:first-child,
      html.v-automator-updating .product__media-item[data-media-id*="{{ featured_media_id }}"] {
        opacity: 1 !important;
      }
    </style>
    <script>
      (function() {
        // Apply loading class immediately
        document.documentElement.classList.add('v-automator-loading');
        
        window.VariantImageAutomator = {
          applyToAll: true,
          isReorderMode: {{ is_reorder_mode | json }},
          product: {
            id: "{{ product.id }}",
            media: [
              {% for media in product.media %}
                { 
                  "id": "{{ media.id | default: forloop.index }}", 
                  "src": {{ media | image_url | json }} 
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          },
          currentVariant: { id: "{{ product.selected_or_first_available_variant.id }}" },
          allVariants: [
            {% for variant in product.variants %}
              {
                "id": "{{ variant.id }}",
                "title": {{ variant.title | json }},
                "featured_image_id": "{{ variant.featured_media.id | default: variant.image.id }}"
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        };
      })();
    </script>
    <script src="{{ 'app.js' | asset_url }}" defer></script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Variant Image Automator",
  "target": "body",
  "javascript": "app.js",
  "settings": []
}
{% endschema %}
